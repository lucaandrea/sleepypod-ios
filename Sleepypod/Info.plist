<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.lucaandrea.freesleep.widgets</string>
			<key>CFBundleURLSchemes</key>
			<array><string>sleepypod-widget</string></array>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.lucaandrea.freesleep.bedtime</string>
			<key>CFBundleURLSchemes</key>
			<array><string>sleepypod-bedtime</string></array>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
		</dict>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.jonathanng.sleepypod.health-sync</string>
		<string>com.lucaandrea.freesleep.health.refresh</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_sleepypod._tcp.</string>
	</array>
	<key>NSHealthShareUsageDescription</key>
	<string>Compare your sleep history with bed data. You can separately choose workouts, activity and earlier wrist temperature as private context. Cloud sharing requires your explicit consent.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Save your selected bed side’s sleep and vitals to Apple Health.</string>
	<key>NSHomeKitUsageDescription</key>
	<string>Access your Apple Home scenes and the connected bed bridge.</string>
	<key>NSAlarmKitUsageDescription</key>
	<string>Add an optional one-time iPhone or iPad backup for your selected Pod wake-up. It can sound through Silent mode and Focus. Existing Clock alarms stay unchanged.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>sleepypod connects to your sleep pod on the local network to control temperature, view sensor data, and track sleep.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>sleepypod listens for snoring on this iPhone while you sleep. Audio is never recorded, saved or uploaded; only snore times are kept.</string>
	<key>UIAppFonts</key>
	<array>
		<string>IBMPlexMono-Light.ttf</string>
		<string>IBMPlexMono-Regular.ttf</string>
		<string>IBMPlexMono-Medium.ttf</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
